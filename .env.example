# Used by the Express API. The defaults match docker-compose.yml.
DATABASE_URL=postgres://emi_user:emi_password@localhost:5432/emi_catalog
PORT=3001

# Optional: required when the Vite frontend is deployed separately from the API.
# Example: VITE_API_BASE_URL=https://your-render-service.onrender.com
VITE_API_BASE_URL=
